{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "noEmit": false,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.tsx",
    "**/*.test.ts",
    "**/*.stories.tsx",
    "**/Form/Form.tsx",
    "**/useFormValidation.ts"
  ]
}
