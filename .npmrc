# Ensure consistent package installation
engine-strict=true
prefer-offline=true
legacy-peer-deps=true

# Configure package resolution
package-lock=true
shamefully-hoist=true

# Private registry - Verdaccio on NAS
registry=http://192.168.1.11:4873/

# Scoped package to local registry
@christianlb:registry=http://192.168.1.11:4873/
