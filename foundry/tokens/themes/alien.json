{
  "$schema": "../schemas/theme.schema.json",
  "name": "alien",
  "description": "Alien biomechanical/Giger inspired theme",
  "extends": "dark",

  "colors": {
    "primitives": {
      "steelOrganic": "#708090",
      "pulsingLife": "#e56e47",
      "adrenaline": "#d4552f",
      "ancientBlood": "#6b7280",
      "primordialVoid": "#0d1117"
    },
    "semantic": {
      "primary": "{primitives.steelOrganic}",
      "secondary": "{primitives.pulsingLife}",
      "destructive": "{primitives.adrenaline}",
      "success": "{primitives.pulsingLife}",
      "warning": "#f6bb93"
    },
    "surface": {
      "background": "#0d1117",
      "foreground": "#f6f7f8",
      "card": "#1f2328",
      "cardForeground": "#f6f7f8",
      "popover": "#323740",
      "popoverForeground": "#f6f7f8",
      "muted": "#565d67",
      "mutedForeground": "#a8aeb5"
    },
    "border": {
      "default": "#6b7280",
      "input": "#454a52",
      "ring": "{primitives.pulsingLife}"
    }
  },

  "effects": {
    "organic": true,
    "pulsing": true,
    "atmospheric": true
  }
}
