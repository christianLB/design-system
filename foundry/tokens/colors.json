{
  "$schema": "./schemas/tokens.schema.json",
  "description": "Base color primitives - raw values that themes build upon",

  "primitives": {
    "blue": "#2563eb",
    "indigo": "#4f46e5",
    "purple": "#7c3aed",
    "pink": "#db2777",
    "green": "#059669",
    "teal": "#0d9488",
    "cyan": "#0891b2",
    "orange": "#ea580c",
    "red": "#dc2626",
    "gray": "#64748b",
    "slate": "#475569",
    "zinc": "#52525b",
    "neutral": "#525252",
    "stone": "#57534e",
    "white": "#ffffff",
    "black": "#000000"
  },

  "semantic": {
    "primary": "{primitives.blue}",
    "secondary": "{primitives.slate}",
    "destructive": "{primitives.red}",
    "success": "{primitives.green}",
    "warning": "{primitives.orange}",
    "info": "{primitives.cyan}"
  },

  "surface": {
    "background": "{primitives.white}",
    "foreground": "#0a0a0a",
    "card": "{primitives.white}",
    "cardForeground": "#0a0a0a",
    "popover": "{primitives.white}",
    "popoverForeground": "#0a0a0a",
    "muted": "#f4f4f5",
    "mutedForeground": "#71717a"
  },

  "border": {
    "default": "#e4e4e7",
    "input": "#e4e4e7",
    "ring": "{semantic.primary}"
  }
}
