{
  "$schema": "./schemas/tokens.schema.json",
  "description": "Border radius tokens",

  "scale": {
    "none": "0",
    "sm": "0.125rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "3xl": "1.5rem",
    "full": "9999px"
  },

  "semantic": {
    "button": "{scale.md}",
    "input": "{scale.md}",
    "card": "{scale.lg}",
    "badge": "{scale.full}",
    "avatar": "{scale.full}",
    "dialog": "{scale.xl}"
  }
}
