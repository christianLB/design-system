{
  "$schema": "./component.schema.json",
  "name": "Checkbox",
  "description": "Binary selection toggle",
  "category": "input",

  "element": {
    "tag": "input",
    "inputType": "checkbox"
  },

  "variants": {
    "size": {
      "description": "Checkbox size variant",
      "values": ["sm", "md", "lg"],
      "default": "md"
    }
  },

  "slots": {
    "root": {
      "description": "The checkbox input",
      "element": "input"
    }
  },

  "states": {
    "disabled": {
      "description": "Checkbox is disabled",
      "attribute": "disabled"
    },
    "checked": {
      "description": "Checkbox is checked",
      "attribute": "checked"
    },
    "indeterminate": {
      "description": "Checkbox is in indeterminate state",
      "prop": "indeterminate"
    }
  },

  "tokens": {
    "base": {
      "borderRadius": "{radius.sm}",
      "accentColor": "var(--color-primary)"
    },
    "size": {
      "sm": {
        "width": "0.875rem",
        "height": "0.875rem"
      },
      "md": {
        "width": "1rem",
        "height": "1rem"
      },
      "lg": {
        "width": "1.25rem",
        "height": "1.25rem"
      }
    }
  },

  "accessibility": {
    "role": "checkbox"
  }
}
