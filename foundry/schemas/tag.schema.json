{
  "$schema": "./component.schema.json",
  "name": "Tag",
  "description": "Label or tag with optional remove action",
  "category": "display",

  "element": {
    "tag": "span"
  },

  "variants": {
    "variant": {
      "description": "Visual variant",
      "values": ["default", "outline", "primary"],
      "default": "default"
    },
    "size": {
      "description": "Tag size",
      "values": ["sm", "md", "lg"],
      "default": "md"
    }
  },

  "slots": {
    "root": {
      "description": "The tag container",
      "element": "span"
    }
  },

  "props": {
    "onRemove": {
      "type": "() => void",
      "description": "Callback when remove button is clicked"
    }
  },

  "tokens": {
    "base": {
      "borderRadius": "{radius.md}",
      "fontWeight": "500"
    },
    "size": {
      "sm": {
        "padding": "0.125rem 0.375rem",
        "fontSize": "0.75rem"
      },
      "md": {
        "padding": "0.25rem 0.5rem",
        "fontSize": "0.75rem"
      },
      "lg": {
        "padding": "0.25rem 0.625rem",
        "fontSize": "0.875rem"
      }
    }
  }
}
