{
  "$schema": "./component.schema.json",
  "name": "Select",
  "description": "Dropdown selection input",
  "category": "input",

  "element": {
    "tag": "select"
  },

  "variants": {
    "size": {
      "description": "Select size variant",
      "values": ["sm", "md", "lg"],
      "default": "md"
    }
  },

  "slots": {
    "root": {
      "description": "The select element",
      "element": "select"
    }
  },

  "states": {
    "disabled": {
      "description": "Select is disabled",
      "attribute": "disabled"
    },
    "invalid": {
      "description": "Select has validation error",
      "attribute": "aria-invalid"
    }
  },

  "props": {
    "placeholder": {
      "type": "string",
      "description": "Placeholder text (first option)"
    }
  },

  "tokens": {
    "base": {
      "width": "100%",
      "appearance": "none",
      "backgroundImage": "url(\"data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e\")",
      "backgroundPosition": "right 0.5rem center",
      "backgroundRepeat": "no-repeat",
      "backgroundSize": "1.5em 1.5em",
      "paddingRight": "{spacing.10}"
    },
    "size": {
      "sm": {
        "height": "{spacing.8}",
        "padding": "0 {spacing.3}",
        "fontSize": "{typography.size.sm}"
      },
      "md": {
        "height": "{spacing.10}",
        "padding": "0 {spacing.4}",
        "fontSize": "{typography.size.sm}"
      },
      "lg": {
        "height": "{spacing.12}",
        "padding": "0 {spacing.5}",
        "fontSize": "{typography.size.base}"
      }
    }
  },

  "accessibility": {
    "role": "combobox"
  }
}
